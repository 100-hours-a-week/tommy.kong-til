# 네이버 뉴스 메인 URL NAVER_NEWS_URL = "https://news.naver.com/main/main.naver?mode=LSD&mid=shm&sid1=100" # 예: 정치 뉴스 (sid1=100) # User-Agent 설정 (네이버가 크롤링 차단하는 경우 우회용) HEADERS = { "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36" } def get_latest_news_links(): """네이버 뉴스 페이지에서 최신 뉴스 기사 링크를 가져옴""" response = requests.get(NAVER_NEWS_URL, headers=HEADERS) soup = BeautifulSoup(response.text, "html.parser") links = [] for a_tag in soup.select(".sh_text a"): # 네이버 뉴스 메인의 기사 링크 선택자 news_link = a_tag.get("href") if news_link and news_link.startswith("https://n.news.naver.com"): links.append(news_link) return list(set(links)) # 중복 제거 def get_news_details(news_url): """개별 뉴스 기사에서 제목, 본문, 날짜, 기자명 추출""" response = requests.get(news_url, headers=HEADERS) soup = BeautifulSoup(response.text, "html.parser") title = soup.select_one(".media_end_head_headline").text.strip() if soup.select_one(".media_end_head_headline") else "N/A" content = soup.select_one("#dic_area").text.strip() if soup.select_one("#dic_area") else "N/A" date = soup.select_one(".media_end_head_info_datestamp time")["datetime"] if soup.select_one(".media_end_head_info_datestamp time") else "N/A" reporter = soup.select_one(".byline_s").text.strip() if soup.select_one(".byline_s") else "N/A" return { "title": title, "content": content, "date": date, "reporter": reporter, "url": news_url } def main(): news_links = get_latest_news_links() news_data = [] print(f"🔍 {len(news_links)}개의 뉴스 기사 링크를 찾았습니다.") for idx, link in enumerate(news_links): try: news_info = get_news_details(link) news_data.append(news_info) print(f"✅ [{idx+1}/{len(news_links)}] {news_info['title'][:30]}... 수집 완료") time.sleep(1) # 서버 부하 방지를 위한 딜레이 except Exception as e: print(f"❌ [{idx+1}] {link} 크롤링 실패: {e}") # DataFrame으로 저장 df = pd.DataFrame(news_data) df.to_csv("naver_news_latest.csv", index=False, encoding="utf-8-sig") print(